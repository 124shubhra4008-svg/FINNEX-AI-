# Copy to .env and load it (or export these) before running the backend.

# Secret used to sign JWT session tokens. Change this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Optional: enables smarter AI chat responses. Leave blank to use the built-in
# offline rule-based assistant (the app works fully without either key).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: enables real email reminders for upcoming bills. Leave blank to
# use the in-app "due soon" banner only (no email). For Gmail, use an App
# Password, not your normal password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
